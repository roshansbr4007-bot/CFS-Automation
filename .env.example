# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Docker PostgreSQL 16
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://cfs_owner:change-me@localhost:5432/cfs_ops

# The Vite dev server
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Used once by: python manage.py create_initial_admin
INITIAL_ADMIN_EMAIL=admin@example.com
# Optional, for non-interactive setup (CI / e2e only). Leave empty to be prompted.
INITIAL_ADMIN_PASSWORD=

# Email for SLA notifications (75% and Overdue). Development prints emails to the console.
# For production set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and the SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=cfs-operations@localhost
